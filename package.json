{
  "name": "netlify-health",
  "version": "1.3.0",
  "description": "Netlify Health desktop wellness companion",
  "main": "main.cjs",
  "author": "Netlify Network",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "android:sync": "cap sync android"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "@capacitor/cli": "^7.4.3",
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.netlifynetwork.health",
    "productName": "Netlify Health",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Netlify-Health-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "netlifynetwork",
        "repo": "netlifyhealth",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@capacitor/android": "^7.4.3"
  }
}
